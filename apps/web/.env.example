# Public values may be exposed to the browser by Next.js.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=local

# Server-only placeholders. Never use production credentials locally or in previews.
DATABASE_URL=postgresql://localhost/curiofold
CLERK_SECRET_KEY=replace-with-development-secret
STRIPE_SECRET_KEY=replace-with-development-secret
STRIPE_WEBHOOK_SECRET=replace-with-development-secret
LOG_LEVEL=debug
